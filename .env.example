# LLM Provider (pick one — GitHub Models is FREE)
# Option 1: GitHub Models (recommended, free with any GitHub account)
GITHUB_TOKEN=ghp_your_github_token_here
LLM_MODEL=gpt-4o-mini

# Option 2: OpenAI (fallback if GITHUB_TOKEN is absent)
# OPENAI_API_KEY=sk-your-openai-key-here

# Telegram Bot for alerts
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Optional: Broker API (Zerodha Kite)
# KITE_API_KEY=
# KITE_API_SECRET=

# Database
DATABASE_URL=sqlite:///data/market.db
